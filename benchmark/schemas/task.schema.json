{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "repository_id",
    "repository_name",
    "application_domain",
    "repository_version",
    "language",
    "classical_algorithm",
    "cryptographic_operation",
    "source_files",
    "function_names",
    "migration_family",
    "migration_target",
    "migration_objective",
    "preconditions",
    "expected_behavior",
    "migration_requirements",
    "original_tests",
    "verification_procedure",
    "difficulty",
    "original_build_status",
    "original_test_status",
    "reference_patch_status",
    "cryptographic_verification_status",
    "validation_status",
    "known_limitations",
    "created_by"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^OPMB-[0-9]{4}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^REPO-[0-9]{3}$"
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "function_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "migration_objective": {
      "type": "string",
      "minLength": 1
    },
    "original_tests": {
      "type": "array",
      "minItems": 1
    },
    "verification_procedure": {
      "type": "array",
      "minItems": 1
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "validation_status": {
      "enum": [
        "candidate",
        "pending",
        "accepted",
        "rejected"
      ]
    }
  },
  "additionalProperties": true
}
