{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "repository_id",
    "name",
    "application_domain",
    "path",
    "purpose",
    "status"
  ],
  "properties": {
    "repository_id": {
      "type": "string",
      "pattern": "^REPO-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "application_domain": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "pending",
        "accepted"
      ]
    }
  },
  "additionalProperties": true
}
