[
  {
    "repository_id": "REPO-241",
    "batch": 1,
    "domain_group": "B1 Industrial automation and manufacturing",
    "name": "WorkcellRecipeVault",
    "slug": "workcell_recipe_vault",
    "entity": "workcell_recipe",
    "purpose": "Controls revisioned production recipes by workcell and approver, preventing an unreviewed recipe from being issued to a line.",
    "workflow": "Recipe authoring, quality review, controlled release, and retirement for one manufacturing workcell.",
    "scope_field": "line_id",
    "rule_field": "recipe_digest",
    "rule_kind": "sha256",
    "rule_description": "Recipe content must be identified by a lowercase SHA-256 digest.",
    "states": [
      "draft",
      "reviewed",
      "released",
      "retired"
    ],
    "transitions": {
      "draft": [
        "reviewed",
        "retired"
      ],
      "reviewed": [
        "released",
        "draft",
        "retired"
      ],
      "released": [
        "retired"
      ],
      "retired": []
    },
    "fields": [
      "record_id",
      "line_id",
      "recipe_digest",
      "revision",
      "approver_id",
      "state"
    ],
    "sample": {
      "record_id": "recipe-241",
      "line_id": "line-press-4",
      "recipe_digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "revision": 3,
      "approver_id": "qa-17",
      "state": "draft"
    },
    "invalid": {
      "recipe_digest": "not-a-digest"
    },
    "baseline_mode": "rsa",
    "classical_signature": "RSA-3072 PSS/SHA-256",
    "classical_key_establishment": "RSA-3072 OAEP/SHA-256 with AES-256-GCM",
    "target": "ML-DSA-65 and ML-KEM-768",
    "differentiation": "Manufacturing execution is gated on a signed recipe revision and its specific workcell; it is not a generic configuration or firmware release."
  },
