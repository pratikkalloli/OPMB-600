      "state": "scheduled"
    },
    "invalid": {
      "measured_error_microns": 9999
    },
    "baseline_mode": "ec",
    "classical_signature": "ECDSA P-256/SHA-256",
    "classical_key_establishment": "X25519 ECDH with HKDF-SHA-256 and AES-256-GCM",
    "target": "ML-DSA-65 and ML-KEM-768",
    "differentiation": "Tolerance-bound calibration certificates for reusable tooling; no sensor fleet telemetry or equipment service order is represented."
  },
