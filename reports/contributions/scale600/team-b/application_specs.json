    "rule_max": 250,
    "rule_description": "Measured dimensional error must be an integer from 0 through 250 microns.",
    "states": [
      "scheduled",
      "measured",
      "accepted",
      "expired"
    ],
    "transitions": {
      "scheduled": [
        "measured",
        "expired"
      ],
      "measured": [
        "accepted",
        "scheduled",
        "expired"
      ],
      "accepted": [
        "expired"
      ],
      "expired": [
        "scheduled"
      ]
    },
    "fields": [
      "record_id",
      "fixture_id",
      "measured_error_microns",
      "calibration_revision",
      "technician_id",
      "state"
    ],
    "sample": {
      "record_id": "cal-243",
      "fixture_id": "fixture-jig-9",
